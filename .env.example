ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_MODEL=
BLOCKFROST_API_KEY_PREPROD=
EVE_PORT=21949
EVE_URL=http://127.0.0.1:21949
COWORKER_ID=

MPS_PORT=38127
MPS_URL=http://127.0.0.1:38127

AGENT_API_PORT=21950
PAID_TASKS_ENABLED=false

# ShillCheck data sources
X_BEARER_TOKEN=
COINGECKO_API_KEY=
COINGECKO_RATE_PER_MIN=90
# Estimated X spend cap per report in USD (users $0.01, posts $0.005). X reads are cached 6h.
SHILLCHECK_MAX_X_COST_USD=8
# How long cached X reads stay usable (hours). Raise for testing, demo and judging.
X_CACHE_TTL_HOURS=6
# false = serve X from cache only; a cache miss is reported as could not verify and costs nothing.
X_LIVE_ALLOWED=true
# Fixtures only. The worker and Standard API refuse to start when true.
SHILLCHECK_MOCK=false
# Absolute path; start.mjs defaults it to <repo>/.local/reports
SHILLCHECK_DATA_DIR=

# PriceProof (agent-to-agent price lookups). Off by default; when off, behaviour is identical to v1.
PRICEPROOF_ENABLED=false
PRICEPROOF_PORT=21960
PRICEPROOF_URL=http://127.0.0.1:21960
# Filled from docs/priceproof-registration-state.json after registration
PRICEPROOF_AGENT_IDENTIFIER=
# Hard limit for the whole sub-purchase, then fall back to local prices (the paid Task has 20 minutes)
PRICEPROOF_TIMEOUT_MS=360000
# Refuse to buy at a higher quoted price (atomic tUSDM; 250000 = 0.25)
PRICEPROOF_MAX_PRICE_ATOMIC=500000
# Seller-side quote
PRICEPROOF_PRICE_ATOMIC=250000
